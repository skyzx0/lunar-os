# --------------------------------------------------------------------------
# running the system's tools


def have(cmd):
    return shutil.which(cmd) is not None


def run(*args, timeout=20):
    """(returncode, stdout, stderr); never raises."""
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, "", str(exc)


def background(work, done=None):
    """Run work() off the UI thread, then done(result) on it."""
    def go():
        result = work()
        if done:
            GLib.idle_add(lambda: (done(result), False)[1])
    threading.Thread(target=go, daemon=True).start()


def nm_split(line):
    """Split one line of nmcli -t output (':' separated, '\\:' escaped)."""
    return [f.replace("\\:", ":") for f in re.split(r"(?<!\\):", line)]


def clear(group):
    """Remove the rows a page added to a preferences group."""
    for row in getattr(group, "_rows", []):
        group.remove(row)
    group._rows = []


def add(group, row):
    group.add(row)
    group._rows = getattr(group, "_rows", []) + [row]
    return row


def icon(name):
    return Gtk.Image.new_from_icon_name(name)


def button(label, cb, style=None, tooltip=None):
    b = Gtk.Button(label=label, valign=Gtk.Align.CENTER, tooltip_text=tooltip)
    if style:
        b.add_css_class(style)
    b.connect("clicked", lambda _b: cb())
    return b


def icon_button(name, cb, tooltip):
    b = Gtk.Button(icon_name=name, valign=Gtk.Align.CENTER, tooltip_text=tooltip)
    b.add_css_class("flat")
    b.connect("clicked", lambda _b: cb())
    return b


