#!/usr/bin/env bash
# Collects the handful of things that explain a failed graphical start.
set -uo pipefail

echo "=== failed units ==="
systemctl --failed --no-pager

echo
echo "=== display manager ==="
systemctl status display-manager.service --no-pager -l | head -30

echo
echo "=== live user creation ==="
systemctl status lunar-live-user.service --no-pager -l | head -20
id lunar 2>&1

echo
echo "=== errors this boot ==="
journalctl -b -p err --no-pager | tail -40

echo
echo "=== sddm log ==="
journalctl -b -u sddm --no-pager | tail -40

echo
echo "=== graphics ==="
lspci -k | grep -A3 -i vga
ls /dev/dri 2>&1

echo
echo "Save this with: lunar-diagnose > /tmp/diag.txt"
