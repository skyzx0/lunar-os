pkgname=lunar-setup
pkgver=0.1.0
pkgrel=1
pkgdesc="Lunar OS installer"
arch=('any')
url="https://lunaros.org"
license=('GPL3')
depends=('python' 'arch-install-scripts' 'cryptsetup' 'lvm2' 'gptfdisk'
         'dosfstools' 'btrfs-progs' 'sbctl' 'reflector')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
# Staged by repo/build-repo.sh from the working tree, so this builds before the
# project has been published anywhere.
source=("lunar-os-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/lunar-os/lunar-setup"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/lunar-os/lunar-setup"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
