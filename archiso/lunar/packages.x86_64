# Live medium contents. The installed system is defined in
# lunar-setup/lunar_setup/install.py, not here.

base
linux-hardened
linux-lts
linux-firmware
intel-ucode
amd-ucode
mkinitcpio
mkinitcpio-archiso
erofs-utils

# installer
python
lunar-setup
lunar-keyring
arch-install-scripts
reflector
sudo
polkit

# storage
cryptsetup
lvm2
