#!/usr/bin/env bash
# lunar-install - opens the installer in a terminal that stays open.
#
# The failure this exists to prevent: konsole -e sudo lunar-setup closes the
# instant the installer exits, so an installer that dies in the first second
# produces a window that flashes and disappears, taking the error with it.
# Here the window is held open on any non-zero exit, and everything is logged.

set -uo pipefail

# Per-user, because running once from the rescue console as root would
# otherwise leave a root-owned log that the desktop session cannot write.
LOG="${TMPDIR:-/tmp}/lunar-setup-$(id -u).log"

# lunar-setup needs root. Which escalation tool exists depends on where this
# runs: the rescue console is already root, the desktop session is not, and
# not every image ships sudo.
as_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v sudo >/dev/null; then
        sudo "$@"
    elif command -v run0 >/dev/null; then
        run0 "$@"
    elif command -v pkexec >/dev/null; then
        pkexec "$@"
    else
        echo "  No way to become root: sudo, run0 and pkexec are all missing." >&2
        echo "  Switch to the rescue console with Ctrl+Alt+F2 and run:" >&2
        echo "    lunar-setup" >&2
        return 127
    fi
}

# --- inner: what runs inside the terminal ---------------------------------

if [[ "${1:-}" == "--run" ]]; then
    clear
    printf '\033]0;Lunar OS installer\007'

    # Tee rather than redirect: the user watches it, and the log survives.
    as_root lunar-setup 2>&1 | tee "$LOG"
    rc=${PIPESTATUS[0]}

    if [[ $rc -ne 0 ]]; then
        echo
        echo "  lunar-setup exited with status $rc"
        echo "  The full output is in $LOG"
        echo
        read -r -p "  Press enter to close this window "
    fi
    exit "$rc"
fi

if [[ "${1:-}" == "--shell" ]]; then
    clear
    cat <<'MSG'

  Lunar OS install shell.

    lunar-setup               start the guided installer (prefix with
                              sudo if you are not root)
    lunar-setup --steps       print the manual commands
    lunar-diagnose            collect system state if something is wrong

MSG
    # zsh with no startup file runs zsh-newuser-install, which puts a
    # configuration wizard in front of someone who asked for a shell. If the
    # skeleton config is missing for any reason, fall back to bash rather
    # than hand them that.
    shell="${SHELL:-/bin/bash}"
    if [[ "$(basename "$shell")" == "zsh" && ! -f "$HOME/.zshrc" ]]; then
        if [[ -f /etc/skel/.zshrc ]]; then
            cp /etc/skel/.zshrc "$HOME/.zshrc"
        else
            shell=/bin/bash
        fi
    fi
    exec "$shell" -i
fi

# --- outer: find a terminal and launch the inner half ---------------------

self="$(command -v lunar-install || echo "$0")"
mode="${1:---run}"

for term in konsole foot alacritty kitty xterm; do
    command -v "$term" >/dev/null || continue
    case "$term" in
        # --nofork keeps konsole in the foreground so this process reflects
        # the terminal's lifetime rather than exiting immediately.
        konsole)   exec "$term" --nofork --hide-menubar --hide-tabbar \
                        -e "$self" "$mode" ;;
        foot)      exec "$term" -e "$self" "$mode" ;;
        alacritty) exec "$term" -e "$self" "$mode" ;;
        kitty)     exec "$term" "$self" "$mode" ;;
        xterm)     exec "$term" -fa Monospace -fs 11 -e "$self" "$mode" ;;
    esac
done

# No terminal at all. Say so somewhere the user will actually see it rather
# than failing silently in a desktop session with no console attached.
msg="No terminal emulator found. Switch to a console with Ctrl+Alt+F2 and run: lunar-setup"
if command -v kdialog >/dev/null; then
    kdialog --error "$msg"
elif command -v zenity >/dev/null; then
    zenity --error --text="$msg"
fi
echo "$msg" >&2
exit 1
