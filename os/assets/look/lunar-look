#!/usr/bin/env python3
"""Lunar Look - one place for the look of every Lunar OS desktop.

    lunar-look                 open the settings app
    lunar-look apply           apply the current settings everywhere
    lunar-look set KEY VALUE   change one setting and apply it
    lunar-look show            print the current settings
    lunar-look reset           back to the Lunar defaults

Settings live in ~/.config/lunaros/look.json (defaults in
/etc/lunaros/look.json). Applying writes a small generated file for each
program - Hyprland, kitty, foot, Alacritty, Konsole, Waybar, the launcher,
Sway, i3, picom, Kvantum - which that program's own config includes. Your own
configs are never rewritten, so anything you add to them stays. Programs
that are running reload; the rest pick it up next time they start.
"""

import colorsys
import json
import os
import re
import shutil
import signal
import subprocess
import sys

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config")
USER_FILE = os.path.join(CONF, "lunaros", "look.json")
SYSTEM_FILE = "/etc/lunaros/look.json"
WALLPAPER_LINK = os.path.join(CONF, "lunaros", "wallpaper")

DEFAULTS = {
    "accent": "#969fff",
    "terminal_opacity": 0.78,
    "window_opacity": 0.92,
    "blur": True,
    "rounding": 14,
    "animation_speed": "fast",
    "wallpaper": "/etc/lunaros/wallpaper.png",
}
SPEEDS = {"fast": 1.0, "normal": 1.6, "slow": 2.4}


# --- settings ----------------------------------------------------------------

def load() -> dict:
    s = dict(DEFAULTS)
    for path in (SYSTEM_FILE, USER_FILE):
        try:
            with open(path) as fh:
                s.update(json.load(fh))
        except (OSError, ValueError):
            pass
    return validate(s)


def validate(s: dict) -> dict:
    """Clamp every value to something every program accepts."""
    out = dict(DEFAULTS)
    if isinstance(s.get("accent"), str) and re.fullmatch(r"#[0-9a-fA-F]{6}", s["accent"]):
        out["accent"] = s["accent"].lower()
    for key, lo in (("terminal_opacity", 0.3), ("window_opacity", 0.5)):
        try:
            out[key] = round(min(1.0, max(lo, float(s.get(key, out[key])))), 2)
        except (TypeError, ValueError):
            pass
    out["blur"] = bool(s.get("blur", out["blur"]))
    try:
        out["rounding"] = int(min(24, max(0, int(s.get("rounding", out["rounding"])))))
    except (TypeError, ValueError):
        pass
    if s.get("animation_speed") in SPEEDS:
        out["animation_speed"] = s["animation_speed"]
    if isinstance(s.get("wallpaper"), str) and os.path.isfile(os.path.expanduser(s["wallpaper"])):
        out["wallpaper"] = os.path.expanduser(s["wallpaper"])
    return out


def save(s: dict) -> None:
    os.makedirs(os.path.dirname(USER_FILE), exist_ok=True)
    with open(USER_FILE, "w") as fh:
        json.dump(validate(s), fh, indent=4)


# --- colours -----------------------------------------------------------------

def rgb(h: str) -> tuple:
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def hexc(r, g, b) -> str:
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(round(v)))) for v in (r, g, b))


def shade(h: str, light: float = None, sat: float = None) -> str:
    """The accent's hue at another lightness/saturation (Material-style tones)."""
    r, g, b = (v / 255 for v in rgb(h))
    hh, l, s = colorsys.rgb_to_hls(r, g, b)
    if light is not None:
        l = light
    if sat is not None:
        s = sat
    return hexc(*(v * 255 for v in colorsys.hls_to_rgb(hh, l, s)))


def second(h: str) -> str:
    """A neighbouring hue for gradients (accent shifted towards violet)."""
    r, g, b = (v / 255 for v in rgb(h))
    hh, l, s = colorsys.rgb_to_hls(r, g, b)
    return hexc(*(v * 255 for v in colorsys.hls_to_rgb((hh + 0.06) % 1, l, s)))


def palette(s: dict) -> dict:
    a = s["accent"]
    return {
        "accent": a, "accent2": second(a),
        "on_accent": "#000000" if colorsys.rgb_to_hls(*(v / 255 for v in rgb(a)))[1] > 0.45 else "#ffffff",
        # Surfaces: near-black, faintly tinted with the accent.
        "bg": shade(a, 0.02, 0.25), "surface": shade(a, 0.05, 0.18),
        "surface2": shade(a, 0.09, 0.14), "outline": shade(a, 0.22, 0.10),
        "fg": "#e2e5f0", "dim": "#8a8f9e",
    }


# --- writing -----------------------------------------------------------------

def write(path: str, text: str) -> bool:
    """Write only if changed; report whether it did."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with open(path) as fh:
            if fh.read() == text:
                return False
    except OSError:
        pass
    with open(path, "w") as fh:
        fh.write(text)
    return True


HEADER = "# Generated by Lunar Look - change it in the Lunar Look app, not here.\n"


def running(name: str) -> bool:
    return subprocess.run(["pgrep", "-x", name], capture_output=True).returncode == 0


def signal_all(name: str, sig: int) -> None:
    out = subprocess.run(["pgrep", "-x", name], capture_output=True, text=True).stdout
    for pid in out.split():
        try:
            os.kill(int(pid), sig)
        except (OSError, ValueError):
            pass


# --- per program -------------------------------------------------------------

def hyprland(s, p, reload):
    a, a2 = p["accent"].lstrip("#"), p["accent2"].lstrip("#")
    k = SPEEDS[s["animation_speed"]]
    sp = lambda base: max(1, round(base * k))
    w = s["window_opacity"]
    write(os.path.join(CONF, "hypr", "lunar-look.conf"), HEADER + f"""
general {{
    col.active_border = rgba({a}cc) rgba({a2}cc) 45deg
}}

decoration {{
    rounding = {s["rounding"]}
    active_opacity = {w}
    inactive_opacity = {round(max(0.4, w - 0.08), 2)}
    blur {{
        enabled = {"true" if s["blur"] else "false"}
    }}
}}

animations {{
    animation = windowsIn,  1, {sp(3)}, decel, popin 85%
    animation = windowsOut, 1, {sp(2)}, accel, popin 85%
    animation = windowsMove, 1, {sp(3)}, decel
    animation = fade,       1, {sp(2)}, decel
    animation = layers,     1, {sp(2)}, decel, slide
    animation = workspaces, 1, {sp(4)}, menu, slide
}}
""")
    if reload and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "reload"], capture_output=True)


def kitty(s, p, reload):
    write(os.path.join(CONF, "kitty", "lunar-look.conf"), HEADER + f"""
background_opacity    {s["terminal_opacity"]}
cursor                {p["accent"]}
selection_background  {p["accent"]}
selection_foreground  {p["on_accent"]}
""")
    if reload:
        signal_all("kitty", signal.SIGUSR1)       # kitty reloads its config


def foot(s, p, reload):
    write(os.path.join(CONF, "foot", "lunar-look.ini"), HEADER + f"""
[colors]
alpha={s["terminal_opacity"]}
""")


def alacritty(s, p, reload):
    write(os.path.join(CONF, "alacritty", "lunar-look.toml"), HEADER + f"""
[window]
opacity = {s["terminal_opacity"]}

[colors.cursor]
cursor = "{p["accent"]}"
text = "{p["on_accent"]}"
""")   # Alacritty watches its config and reloads by itself.


def konsole(s, p, reload):
    src = "/usr/share/konsole/Lunar.colorscheme"
    if not os.path.isfile(src):
        return
    with open(src) as fh:
        t = fh.read()
    t = re.sub(r"(?m)^Opacity=.*$", f"Opacity={s['terminal_opacity']}", t)
    t = re.sub(r"(?m)^Blur=.*$", f"Blur={'true' if s['blur'] else 'false'}", t)
    t = t.replace("150,160,255", "%d,%d,%d" % rgb(p["accent"]))
    write(os.path.join(HOME, ".local", "share", "konsole", "Lunar.colorscheme"), t)


def waybar(s, p, reload):
    r, g, b = rgb(p["bg"])
    write(os.path.join(CONF, "waybar", "lunar-look.css"), "/* Generated by Lunar Look. */\n" + f"""
@define-color accent {p["accent"]};
@define-color on_accent {p["on_accent"]};
@define-color glass rgba({r}, {g}, {b}, {round(max(0.35, s["window_opacity"] - 0.2), 2)});
@define-color fg {p["fg"]};
@define-color dim {p["dim"]};
""")
    if reload:
        signal_all("waybar", signal.SIGUSR2)      # waybar reloads its style


def wofi(s, p, reload):
    r, g, b = rgb(p["bg"])
    ar, ag, ab = rgb(p["accent"])
    write(os.path.join(CONF, "wofi", "style.css"), "/* Generated by Lunar Look. */\n" + f"""
window {{
    background-color: rgba({r}, {g}, {b}, {round(max(0.5, s["window_opacity"] - 0.06), 2)});
    border: 1px solid rgba({ar}, {ag}, {ab}, 0.35);
    border-radius: {s["rounding"] + 2}px;
    font-family: "Noto Sans", sans-serif;
    font-size: 14px;
}}
#outer-box {{ padding: 14px; }}
#input {{
    background-color: rgba(255, 255, 255, 0.06);
    color: {p["fg"]};
    border: none;
    border-radius: {max(4, s["rounding"] - 4)}px;
    padding: 8px 12px;
    margin-bottom: 10px;
}}
#entry {{ padding: 7px 10px; border-radius: {max(4, s["rounding"] - 4)}px; }}
#entry:selected {{ background-color: {p["accent"]}; }}
#text {{ color: {p["fg"]}; margin-left: 6px; }}
#entry:selected #text {{ color: {p["on_accent"]}; }}
""")


def sway(s, p, reload):
    a, out = p["accent"], p["outline"]
    write(os.path.join(CONF, "sway", "lunar-look"), HEADER + f"""
for_window [app_id=".*"] opacity {s["window_opacity"]}
for_window [class=".*"] opacity {s["window_opacity"]}
client.focused          {a} #000000 {p["fg"]} {a} {a}
client.unfocused        {out} #000000 {p["dim"]} {out} {out}
client.focused_inactive {out} #000000 {p["dim"]} {out} {out}
""")
    if reload and os.environ.get("SWAYSOCK"):
        subprocess.run(["swaymsg", "reload"], capture_output=True)


def i3(s, p, reload):
    a, out = p["accent"], p["outline"]
    write(os.path.join(CONF, "i3", "lunar-look"), HEADER + f"""
client.focused          {a} #000000 {p["fg"]} {a} {a}
client.unfocused        {out} #000000 {p["dim"]} {out} {out}
client.focused_inactive {out} #000000 {p["dim"]} {out} {out}
""")
    w = s["window_opacity"]
    write(os.path.join(CONF, "picom", "picom.conf"), HEADER.replace("#", "#", 1) + f"""
backend = "glx";
vsync = true;
corner-radius = {s["rounding"]};
shadow = false;
active-opacity = 1.0;
inactive-opacity = {w};
inactive-opacity-override = false;
opacity-rule = [ "100:_NET_WM_STATE@[*]:32a *= '_NET_WM_STATE_FULLSCREEN'" ];
{'blur-method = "dual_kawase";' if s["blur"] else 'blur-method = "none";'}
blur-strength = 5;
blur-background-exclude = [ "window_type = 'desktop'" ];
fading = true;
fade-in-step = 0.08;
fade-out-step = 0.08;
""")
    if reload and os.environ.get("I3SOCK") or (reload and running("i3")):
        subprocess.run(["i3-msg", "reload"], capture_output=True)
        signal_all("picom", signal.SIGUSR1)


# Kvantum: Plasma's translucent windows, done by the theme rather than by
# forcing window opacity (which makes accelerated apps flicker).
KV_BASE = "/usr/share/Kvantum/KvFlat"
_HEX = re.compile(r"(?<![\w])#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})(?![0-9a-zA-Z_-])")


def kv_recolor(svg: str, accent: str) -> str:
    """Every colour in KvFlat's drawing, moved into Lunar's palette.

    Greys darken towards black with a faint accent tint, so frames and
    buttons sit on a black background; coloured parts (KvFlat's blues) turn
    to the accent's hue; near-white (text, check marks) is left alone.
    """
    ha, la, sa = colorsys.rgb_to_hls(*(v / 255 for v in rgb(accent)))

    def fix(m):
        h = m.group(1)
        if len(h) == 3:
            h = "".join(c * 2 for c in h)
        hh, l, s = colorsys.rgb_to_hls(*(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)))
        if l >= 0.8 or l == 0.0:
            return "#" + h
        if s < 0.15:                                   # grey
            r, g, b = colorsys.hls_to_rgb(ha, l * 0.55, 0.10)
        else:                                          # colour -> accent
            nl = min(0.88, max(0.30, la - (0.58 - l) * 0.5))   # KvFlat's main blue -> the accent
            r, g, b = colorsys.hls_to_rgb(ha, nl, min(s, sa) * 0.85)
        return hexc(r * 255, g * 255, b * 255)

    return _HEX.sub(fix, svg)


def kvantum(s, p, reload):
    if not os.path.isdir(KV_BASE):
        return
    d = os.path.join(CONF, "Kvantum", "Lunar")
    with open(os.path.join(KV_BASE, "KvFlat.svg")) as fh:
        svg = kv_recolor(fh.read(), p["accent"])
    write(os.path.join(d, "Lunar.svg"), svg)

    with open(os.path.join(KV_BASE, "KvFlat.kvconfig")) as fh:
        cfg = fh.read()
    reduce = int(round((1 - s["window_opacity"]) * 100))
    general = {
        "translucent_windows": "true", "blurring": "true" if s["blur"] else "false",
        "popup_blurring": "true" if s["blur"] else "false",
        "reduce_window_opacity": str(min(90, max(0, reduce))),
        "reduce_menu_opacity": str(min(90, max(0, reduce // 2))),
        "composite": "true", "menu_shadow_depth": "0", "spread_menuitems": "true",
    }
    colors = {
        "window.color": p["bg"], "base.color": p["bg"], "alt.base.color": p["surface"],
        "button.color": p["surface2"], "light.color": p["outline"], "mid.light.color": p["surface2"],
        "dark.color": "#000000", "mid.color": p["surface"], "highlight.color": p["accent"],
        "inactive.highlight.color": shade(p["accent"], 0.35), "text.color": p["fg"],
        "window.text.color": p["fg"], "button.text.color": p["fg"], "disabled.text.color": p["dim"],
        "tooltip.text.color": p["fg"], "highlight.text.color": p["on_accent"],
        "link.color": p["accent"], "link.visited.color": p["accent2"],
        "progress.indicator.text.color": p["fg"],
    }

    def set_keys(text, section, values):
        m = re.search(r"(?ms)^\[" + re.escape(section) + r"\]\n(.*?)(?=^\[|\Z)", text)
        body = m.group(1) if m else ""
        for k, v in values.items():
            if re.search(r"(?m)^" + re.escape(k) + r"=", body):
                body = re.sub(r"(?m)^" + re.escape(k) + r"=.*$", f"{k}={v}", body)
            else:
                body = body.rstrip("\n") + f"\n{k}={v}\n"
        if m:
            return text[:m.start(1)] + body + text[m.end(1):]
        return text.rstrip("\n") + f"\n\n[{section}]\n" + body

    cfg = set_keys(cfg, "%General", general)
    cfg = set_keys(cfg, "GeneralColors", colors)
    write(os.path.join(d, "Lunar.kvconfig"), cfg)
    write(os.path.join(CONF, "Kvantum", "kvantum.kvconfig"), "[General]\ntheme=Lunar\n")


def plasma(s, p, reload):
    if not shutil.which("plasmashell"):
        return
    if shutil.which("kwriteconfig6"):
        subprocess.run(["kwriteconfig6", "--file", "kdeglobals", "--group", "KDE",
                        "--key", "widgetStyle", "kvantum"], capture_output=True)
    if reload and os.environ.get("XDG_CURRENT_DESKTOP", "").upper().find("KDE") >= 0:
        subprocess.run(["plasma-apply-colorscheme", "--accent-color", p["accent"]], capture_output=True)
        subprocess.run(["plasma-apply-wallpaperimage", s["wallpaper"]], capture_output=True)


GNOME_ACCENTS = {"blue": "#3584e4", "teal": "#2190a4", "green": "#3a944a", "yellow": "#c88800",
                 "orange": "#ed5b00", "red": "#e62d42", "pink": "#d56199", "purple": "#9141ac",
                 "slate": "#6f8396"}


def gnome(s, p, reload):
    if not (reload and "GNOME" in os.environ.get("XDG_CURRENT_DESKTOP", "").upper()):
        return
    hue = colorsys.rgb_to_hls(*(v / 255 for v in rgb(p["accent"])))[0]
    def dist(h):
        x = colorsys.rgb_to_hls(*(v / 255 for v in rgb(h)))[0]
        return min(abs(x - hue), 1 - abs(x - hue))
    name = min(GNOME_ACCENTS, key=lambda n: dist(GNOME_ACCENTS[n]))
    uri = "file://" + s["wallpaper"]
    for schema, key, val in [("org.gnome.desktop.interface", "accent-color", name),
                             ("org.gnome.desktop.background", "picture-uri", uri),
                             ("org.gnome.desktop.background", "picture-uri-dark", uri)]:
        subprocess.run(["gsettings", "set", schema, key, val], capture_output=True)


def wallpaper(s, p, reload):
    """One link every desktop points at; changing it moves them all."""
    os.makedirs(os.path.dirname(WALLPAPER_LINK), exist_ok=True)
    try:
        if os.path.realpath(WALLPAPER_LINK) != os.path.realpath(s["wallpaper"]):
            if os.path.lexists(WALLPAPER_LINK):
                os.remove(WALLPAPER_LINK)
            os.symlink(s["wallpaper"], WALLPAPER_LINK)
    except OSError:
        return
    if not reload:
        return
    if running("swaybg"):
        subprocess.run(["pkill", "-x", "swaybg"])
        subprocess.Popen(["swaybg", "-m", "fill", "-i", WALLPAPER_LINK], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if os.environ.get("DISPLAY") and shutil.which("feh") and running("i3"):
        subprocess.run(["feh", "--no-fehbg", "--bg-fill", WALLPAPER_LINK], capture_output=True)
    if os.environ.get("SWAYSOCK"):
        subprocess.run(["swaymsg", "output", "*", "bg", WALLPAPER_LINK, "fill"], capture_output=True)


TARGETS = [wallpaper, hyprland, kitty, foot, alacritty, konsole, waybar, wofi,
           sway, i3, kvantum, plasma, gnome]


def apply(s: dict = None, reload: bool = True) -> None:
    s = validate(s or load())
    p = palette(s)
    for target in TARGETS:
        try:
            target(s, p, reload)
        except Exception as e:          # one program's trouble must not stop the rest
            print(f"lunar-look: {target.__name__}: {e}", file=sys.stderr)


# --- command line ------------------------------------------------------------

def main(argv):
    if not argv:
        from importlib.machinery import SourceFileLoader
        gui = os.path.join(os.path.dirname(os.path.realpath(__file__)), "lunar-look-app")
        if not os.path.exists(gui):
            gui = "/usr/local/lib/lunaros/lunar-look-app"
        SourceFileLoader("lunar_look_app", gui).load_module().run()
        return 0
    cmd, *rest = argv
    if cmd == "apply":
        apply(reload="--no-reload" not in rest)
    elif cmd == "show":
        print(json.dumps(load(), indent=4))
    elif cmd == "reset":
        if os.path.exists(USER_FILE):
            os.remove(USER_FILE)
        apply()
    elif cmd == "set" and len(rest) == 2:
        s = load()
        key, val = rest
        if key not in DEFAULTS:
            print(f"lunar-look: unknown setting '{key}' ({', '.join(DEFAULTS)})", file=sys.stderr)
            return 2
        if isinstance(DEFAULTS[key], bool):
            val = val.lower() in ("1", "true", "yes", "on")
        elif isinstance(DEFAULTS[key], (int, float)):
            val = float(val)
        s[key] = val
        save(s)
        apply()
    else:
        print(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
