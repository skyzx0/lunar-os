#!/usr/bin/env python3
"""lunar-privacy - network identity and cover traffic.

Two independent features, both off by default, both toggleable at runtime:

  spoof   Randomise the things that identify this machine on a network:
          MAC address, hostname, and DNS. This is genuinely useful and low
          cost. It is what "device spoofing" should mean.

  cover   Generate decoy traffic to obscure when you are actually active.
          This is far weaker than it sounds and is presented as such. Read
          `lunar-privacy explain cover` before turning it on.

  lunar-privacy status
  lunar-privacy spoof on|off
  lunar-privacy cover on|off [--rate low|medium|high]
  lunar-privacy explain <spoof|cover>
"""

import argparse
import os
import random
import subprocess
import sys
import time

RESET = "\033[0m"; DIM = "\033[2m"; BOLD = "\033[1m"
MOON = "\033[36m"; WARN = "\033[33m"; BAD = "\033[31m"; OK = "\033[32m"

STATE_DIR = "/etc/lunar/privacy"
SPOOF_FLAG = f"{STATE_DIR}/spoof.enabled"
COVER_FLAG = f"{STATE_DIR}/cover.enabled"
NM_CONF = "/etc/NetworkManager/conf.d/99-lunar-privacy.conf"


def c(s, col):
    return s if not sys.stdout.isatty() else f"{col}{s}{RESET}"


def root_or_die():
    if os.geteuid() != 0:
        sys.exit("lunar-privacy must run as root (try: sudo lunar-privacy ...)")


def run(args, **kw):
    return subprocess.run(args, **kw)


# --------------------------------------------------------------------------
# spoof: MAC + hostname + DNS


SPOOF_NM = """# Managed by lunar-privacy. Remove with: lunar-privacy spoof off
[connection]
# A new random MAC per connection, and a fresh one on each scan, so the
# hardware address is never a durable identifier on a network.
wifi.cloned-mac-address=random
ethernet.cloned-mac-address=random
connection.stable-id=${CONNECTION}/${BOOT}

[device]
wifi.scan-rand-mac-address=yes

[ipv6]
# Stable-privacy addresses rather than ones derived from the MAC.
ip6-privacy=2
"""


def spoof_on():
    root_or_die()
    os.makedirs(STATE_DIR, exist_ok=True)
    os.makedirs(os.path.dirname(NM_CONF), exist_ok=True)
    with open(NM_CONF, "w") as fh:
        fh.write(SPOOF_NM)

    # A random but plausible hostname. A blank or obviously-fake name is itself
    # a signal; something that looks like a default laptop name blends in.
    adjectives = ["quiet", "grey", "north", "amber", "slate", "harbor", "cedar"]
    host = f"{random.choice(adjectives)}-{random.randint(1000, 9999)}"
    run(["hostnamectl", "set-hostname", "--transient", host])

    open(SPOOF_FLAG, "w").close()
    run(["systemctl", "restart", "NetworkManager"], check=False)
    print(c("  spoofing on", OK))
    print(f"  transient hostname: {host}")
    print(c("  reconnect to networks for new MACs to take effect", DIM))


def spoof_off():
    root_or_die()
    for path in (NM_CONF, SPOOF_FLAG):
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
    # Restore the permanent hostname from /etc/hostname.
    try:
        with open("/etc/hostname") as fh:
            run(["hostnamectl", "set-hostname", fh.read().strip()])
    except FileNotFoundError:
        pass
    run(["systemctl", "restart", "NetworkManager"], check=False)
    print(c("  spoofing off", OK))


# --------------------------------------------------------------------------
# cover: decoy traffic


COVER_SERVICE = "/etc/systemd/system/lunar-cover.service"

COVER_UNIT = """[Unit]
Description=Lunar cover traffic generator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/lunar-privacy _cover-daemon
Restart=on-failure
RestartSec=30
# Cover traffic is best-effort background noise, not something worth CPU or
# memory pressure. Cap it hard and run it at the lowest priority.
Nice=19
IOSchedulingClass=idle
CPUQuota=5%
MemoryMax=64M
DynamicUser=yes
RestrictAddressFamilies=AF_INET AF_INET6
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
"""

# Ordinary destinations. Cover traffic to obviously-random IPs would stand out
# more than no cover traffic at all; blending with normal browsing means
# reaching things a browser reaches.
COVER_HOSTS = [
    "https://www.wikipedia.org", "https://www.debian.org",
    "https://archlinux.org", "https://www.kernel.org",
    "https://www.gnu.org", "https://news.ycombinator.com",
    "https://www.reddit.com", "https://github.com",
]

RATE_DELAYS = {"low": (60, 240), "medium": (20, 90), "high": (5, 30)}


def cover_on(rate: str):
    root_or_die()
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(COVER_FLAG, "w") as fh:
        fh.write(rate)
    with open(COVER_SERVICE, "w") as fh:
        fh.write(COVER_UNIT)
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "--now", "lunar-cover.service"], check=False)
    print(c(f"  cover traffic on ({rate})", OK))
    print()
    _cover_caveat()


def cover_off():
    root_or_die()
    run(["systemctl", "disable", "--now", "lunar-cover.service"], check=False)
    try:
        os.remove(COVER_FLAG)
    except FileNotFoundError:
        pass
    print(c("  cover traffic off", OK))


def cover_daemon():
    """The generator. Fetches ordinary sites at randomised intervals.

    Deliberately simple: real cover traffic that defeats a capable analyst is
    an unsolved research problem, and pretending otherwise would be worse than
    doing nothing. This raises the cost of casual observation, no more.
    """
    try:
        rate = open(COVER_FLAG).read().strip() or "medium"
    except FileNotFoundError:
        rate = "medium"
    lo, hi = RATE_DELAYS.get(rate, RATE_DELAYS["medium"])

    import urllib.request
    while True:
        url = random.choice(COVER_HOSTS)
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=10) as resp:
                # Read a random slice so response sizes vary.
                resp.read(random.randint(1024, 65536))
        except Exception:
            pass
        time.sleep(random.uniform(lo, hi))


# --------------------------------------------------------------------------
# explain


def _cover_caveat():
    print(c("  What cover traffic does and does not do", WARN))
    print("""
  It does:  raise the effort for someone casually watching your connection
            to tell when you are actively using it.

  It does NOT:
    - hide what sites you visit (that is your DNS and SNI, use spoof + a VPN)
    - defeat timing correlation by a capable observer, who can still see your
      real traffic underneath the noise
    - make you anonymous

  A machine emitting constant background traffic also has a recognisable
  signature. Against a serious adversary this can make you more identifiable,
  not less. Leave it off unless you understand that trade.
""")


def cmd_explain(args):
    if args.topic == "spoof":
        print(c("spoof - network identity randomisation", MOON))
        print("""
  Randomises three things that otherwise follow you between networks:

    MAC address   The hardware ID your network card broadcasts. Randomised
                  per connection, so a coffee shop cannot link today's visit
                  to last week's.
    Hostname      The name your machine announces over DHCP and mDNS. Set to
                  a neutral transient name.
    IPv6          Privacy-stable addresses instead of ones derived from the
                  MAC.

  Low cost, genuinely useful, safe to leave on. The main visible effect is
  that networks treat you as a new device each time you connect.
""")
    else:
        _cover_caveat()
    return 0


# --------------------------------------------------------------------------
# status


def cmd_status(args):
    print(c("Lunar network privacy", MOON))

    spoof = os.path.exists(SPOOF_FLAG)
    print(f"  spoof   {c('on', OK) if spoof else c('off', DIM)}")
    if spoof:
        host = subprocess.run(["hostname"], capture_output=True, text=True).stdout.strip()
        print(f"          hostname {host}, MAC randomised per connection")

    cover = os.path.exists(COVER_FLAG)
    if cover:
        rate = open(COVER_FLAG).read().strip()
        active = subprocess.run(["systemctl", "is-active", "lunar-cover.service"],
                                capture_output=True, text=True).stdout.strip()
        print(f"  cover   {c('on', OK)} ({rate}, service {active})")
    else:
        print(f"  cover   {c('off', DIM)}")

    # Show the current MAC(s) so 'on' is verifiable rather than asserted.
    try:
        out = subprocess.run(["ip", "-br", "link"], capture_output=True, text=True).stdout
        print(c("\n  interfaces", DIM))
        for line in out.splitlines():
            if line.split()[0] != "lo":
                print("    " + line.strip())
    except Exception:
        pass
    return 0


def cmd_spoof(args):
    spoof_on() if args.state == "on" else spoof_off()
    return 0


def cmd_cover(args):
    if args.state == "on":
        cover_on(args.rate)
    else:
        cover_off()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="lunar-privacy",
                                 description="Network identity and cover traffic")
    sub = ap.add_subparsers(dest="cmd")

    sub.add_parser("status")
    s = sub.add_parser("spoof"); s.add_argument("state", choices=["on", "off"])
    s = sub.add_parser("cover")
    s.add_argument("state", choices=["on", "off"])
    s.add_argument("--rate", choices=["low", "medium", "high"], default="medium")
    s = sub.add_parser("explain"); s.add_argument("topic", choices=["spoof", "cover"])
    sub.add_parser("_cover-daemon")     # internal, run by the service

    args = ap.parse_args()
    if args.cmd == "_cover-daemon":
        cover_daemon()
        return 0
    if not args.cmd:
        return cmd_status(args)
    return {
        "status": cmd_status, "spoof": cmd_spoof,
        "cover": cmd_cover, "explain": cmd_explain,
    }[args.cmd](args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
