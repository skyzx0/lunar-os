#!/usr/bin/env bash
# Live medium account setup.
#
# The session is a console owned by root. There is no display manager and no
# unprivileged desktop user, because the only thing this medium exists to do
# is run an installer, and that needs root anyway.
set -euo pipefail

# Empty password, not a locked account: pam_unix with nullok accepts it at a
# console, and a locked root on a medium with no other account would mean no
# way in at all when something fails.
passwd -d root

# A zsh with no startup file runs its new-user wizard, which puts a
# configuration questionnaire in front of anyone opening a shell.
for f in .zshrc .zprofile; do
    [ -f "/etc/skel/$f" ] || continue
    [ -f "/root/$f" ] || install -Dm644 "/etc/skel/$f" "/root/$f"
done
