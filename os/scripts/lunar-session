#!/usr/bin/env bash
# lunar-session - starts the Lunar desktop.
#
# First sign-in: puts the Lunar desktop's settings into ~/.config (only the
# files you don't have yet, so your own changes are never overwritten), then
# applies Lunar Look and starts Hyprland through its own launcher.

skel=/etc/lunaros/skel
mark="$HOME/.config/lunaros/.skel-version"
version=$(readlink -f "$skel")
if [[ "$(cat "$mark" 2>/dev/null)" != "$version" ]]; then
    mkdir -p "$HOME/.config/lunaros"
    cp -rL --no-preserve=mode,ownership --update=none "$skel/." "$HOME/.config/"
    echo "$version" > "$mark"
fi
# The wallpaper every part of the desktop points at.
[[ -e "$HOME/.config/lunaros/wallpaper" ]] || ln -sfn /etc/lunaros/wallpaper.png "$HOME/.config/lunaros/wallpaper"
# Your Lunar Look choices (the desktop also works without them: defaults ship
# with it). Anything that goes wrong is kept in ~/.cache/lunar-session.log.
mkdir -p "$HOME/.cache"
lunar-look apply --no-reload > "$HOME/.cache/lunar-session.log" 2>&1 || true

export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland
if command -v start-hyprland >/dev/null; then
    exec start-hyprland
fi
exec Hyprland
