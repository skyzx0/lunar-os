#!/usr/bin/env bash
# Unattended installation, for automated testing only.
#
# Runs only when the kernel was booted with lunar.autoinstall on its command
# line. Nothing on a normal boot reaches this, and there is no way to trigger
# it from the welcome screen: it erases a disk without asking anything.
set -uo pipefail

grep -qw "lunar.autoinstall" /proc/cmdline || exit 0

answers=/etc/lunar/autoinstall.json
disk="$(sed -n 's/.*lunar\.disk=\([^ ]*\).*/\1/p' /proc/cmdline)"
if [[ -n "$disk" ]]; then
    python3 - "$answers" "$disk" <<'PY'
import json, sys
path, disk = sys.argv[1], sys.argv[2]
data = json.load(open(path))
data["disk"] = disk
json.dump(data, open(path, "w"), indent=2)
PY
fi

echo
echo "=== LUNAR AUTOINSTALL ==="
cat "$answers"
echo

lunaros-setup --unattended "$answers"
rc=$?

echo
if [[ $rc -eq 0 ]]; then
    echo "=== LUNAR AUTOINSTALL OK ==="
else
    echo "=== LUNAR AUTOINSTALL FAILED rc=$rc ==="
    echo "--- transcript ---"
    cat /tmp/lunar-setup.log 2>/dev/null
    echo "--- end transcript ---"
fi

sync
systemctl poweroff
