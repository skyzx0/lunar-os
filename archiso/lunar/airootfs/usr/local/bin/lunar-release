#!/usr/bin/env bash
# Free a disk left held by an interrupted installation, and clear the
# metadata that causes it to be re-held.
#
# lunaros-setup does all of this itself. This is for recovering by hand.
set -uo pipefail

disk="${1:-}"
if [[ -z "$disk" ]]; then
    echo "usage: lunar-release /dev/nvme0n1"
    echo
    lsblk -d -o PATH,SIZE,MODEL
    exit 1
fi

echo ":: releasing $disk"

# udev reactivates volume groups the moment it sees their metadata, so stop
# it before touching anything.
systemctl mask --runtime lvm2-pvscan@.service >/dev/null 2>&1

swapoff -a 2>/dev/null && echo "  swap off"
umount -R /mnt 2>/dev/null && echo "  /mnt unmounted"

pvs --noheadings -o pv_name,vg_name 2>/dev/null | while read -r pv vg; do
    [[ "$pv" == "$disk"* ]] || continue
    echo "  deactivating volume group $vg"
    vgchange -an "$vg" >/dev/null 2>&1
    vgremove -f "$vg" >/dev/null 2>&1
done

for mapping in $(dmsetup ls --target crypt 2>/dev/null | awk '{print $1}'); do
    echo "  closing $mapping"
    cryptsetup close "$mapping" 2>/dev/null || dmsetup remove --force "$mapping" 2>/dev/null
done

# Clear signatures inside each partition, then the table itself. Doing it in
# this order matters: wiping only the table leaves the metadata that causes
# the disk to be grabbed again on the next scan.
for part in $(lsblk -lno PATH,TYPE "$disk" | awk '$2=="part"{print $1}'); do
    echo "  wiping $part"
    wipefs -a "$part" >/dev/null 2>&1
    dd if=/dev/zero of="$part" bs=1M count=16 conv=fsync status=none 2>/dev/null
done
wipefs -a "$disk" >/dev/null 2>&1

udevadm settle
systemctl unmask --runtime lvm2-pvscan@.service >/dev/null 2>&1

if wipefs --noheadings "$disk" >/dev/null 2>&1; then
    echo ":: $disk is free"
    lsblk "$disk"
else
    echo ":: $disk is still busy - reboot the live medium" >&2
    exit 1
fi
