class ControlWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Lunar Control")
        self.set_default_size(860, 620)
        self.add_css_class("lunar")
        self.toasts = Adw.ToastOverlay()

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               transition_duration=160)
        self.pages = {}
        for cls in (WifiPage, BluetoothPage, SoundPage, DisplayPage, PowerPage, AboutPage):
            p = cls(self)
            self.pages[p.key] = p
            self.stack.add_named(p, p.key)

        self.sidebar = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.sidebar.add_css_class("navigation-sidebar")
        self._rows = {}
        for key, title, ico in PAGES:
            row = Gtk.ListBoxRow()
            box = Gtk.Box(spacing=12, margin_top=8, margin_bottom=8, margin_start=6)
            box.append(icon(ico))
            box.append(Gtk.Label(label=title, xalign=0))
            row.set_child(box)
            row.key = key
            self.sidebar.append(row)
            self._rows[key] = row
        self.sidebar.connect("row-selected", lambda _l, r: r and self.show_page(r.key, False))

        side = Adw.ToolbarView()
        side_header = Adw.HeaderBar()
        side_title = Gtk.Label(label="◗  Lunar")
        side_title.add_css_class("heading")
        side_header.set_title_widget(side_title)
        side_header.set_show_end_title_buttons(False)
        side.add_top_bar(side_header)
        side.set_content(self.sidebar)

        main = Adw.ToolbarView()
        self.title = Adw.WindowTitle()
        main.add_top_bar(Adw.HeaderBar(title_widget=self.title))
        main.set_content(self.stack)

        split = Adw.NavigationSplitView(min_sidebar_width=200, max_sidebar_width=230)
        split.set_sidebar(Adw.NavigationPage(child=side, title="Lunar"))
        split.set_content(Adw.NavigationPage(child=main, title="Lunar Control"))
        self.toasts.set_child(split)
        self.set_content(self.toasts)

        esc = Gtk.ShortcutController()
        esc.add_shortcut(Gtk.Shortcut(trigger=Gtk.ShortcutTrigger.parse_string("Escape"),
                                      action=Gtk.CallbackAction.new(lambda *_: (self.close(), True)[1])))
        self.add_controller(esc)

    def show_page(self, key, select=True):
        key = key if key in self.pages else "wifi"
        if select:
            self.sidebar.select_row(self._rows[key])
        self.stack.set_visible_child_name(key)
        self.title.set_title(dict((k, t) for k, t, _ in PAGES)[key])
        self.pages[key].refresh()

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=3))


class ControlApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        css = Gtk.CssProvider()
        css.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        page = args[0] if args else "wifi"
        if page in ("-h", "--help"):
            cmdline.print_literal(__doc__.strip() + "\n")
            return 0
        if not self.win:
            self.win = ControlWindow(self)
        self.win.show_page(page)
        self.win.present()
        return 0


if __name__ == "__main__":
    sys.exit(ControlApp().run(sys.argv))
