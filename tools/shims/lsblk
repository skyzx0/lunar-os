#!/usr/bin/env python3
"""lsblk, with the gaps a missing udev leaves filled in from the disk itself.

For test environments only. lsblk takes partition numbers, partition UUIDs,
filesystem types and filesystem UUIDs from udev's database. Inside a
container, udev never receives the kernel's device events - they are
delivered only to the host's network namespace - so those fields come back
empty. archinstall then cannot identify the partitions it just created, and
stops with "Unable to determine new partition number".

Every one of those values is also readable directly: the partition number
from sysfs, everything else from blkid probing the device. This runs the real
lsblk with the same arguments and fills only the fields it left null. Fields
lsblk did populate are never touched, so on a system where udev works this
changes nothing.
"""

import json
import os
import shutil
import subprocess
import sys

REAL = None
for d in ("/usr/bin", "/usr/sbin", "/bin", "/sbin"):
    candidate = os.path.join(d, "lsblk")
    if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
        REAL = candidate
        break
if REAL is None:
    sys.exit("lsblk shim: the real lsblk was not found")

# Only JSON output can be patched safely; anything else passes straight
# through untouched.
if "--json" not in sys.argv[1:] and "-J" not in sys.argv[1:]:
    os.execv(REAL, [REAL] + sys.argv[1:])

result = subprocess.run([REAL] + sys.argv[1:], capture_output=True, text=True)
if result.returncode != 0:
    sys.stderr.write(result.stderr)
    sys.exit(result.returncode)

try:
    data = json.loads(result.stdout)
except json.JSONDecodeError:
    sys.stdout.write(result.stdout)
    sys.exit(0)


def probe(path: str) -> dict:
    """blkid's low-level probe: reads the device, ignores any cache."""
    blkid = shutil.which("blkid") or "/usr/bin/blkid"
    r = subprocess.run([blkid, "-p", "-o", "export", path],
                       capture_output=True, text=True)
    out = {}
    for line in r.stdout.splitlines():
        key, sep, value = line.partition("=")
        if sep:
            out[key] = value
    return out


def sysfs_partn(name: str):
    try:
        with open(f"/sys/class/block/{name}/partition") as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return None


def fill(dev: dict) -> None:
    name = dev.get("name") or ""
    path = dev.get("path") or (f"/dev/{name}" if name else "")
    if not path or not os.path.exists(path):
        return

    kind = dev.get("type")
    info = probe(path)

    def set_if_missing(key, value):
        if key in dev and dev[key] in (None, "") and value not in (None, ""):
            dev[key] = value

    if kind == "part":
        set_if_missing("partn", sysfs_partn(os.path.basename(path))
                       or (int(info["PART_ENTRY_NUMBER"])
                           if info.get("PART_ENTRY_NUMBER", "").isdigit() else None))
        set_if_missing("partuuid", info.get("PART_ENTRY_UUID"))
        set_if_missing("parttype", info.get("PART_ENTRY_TYPE"))
        set_if_missing("pttype", info.get("PART_ENTRY_SCHEME"))
    else:
        set_if_missing("pttype", info.get("PTTYPE"))
        set_if_missing("ptuuid", info.get("PTUUID"))

    set_if_missing("uuid", info.get("UUID"))
    set_if_missing("fstype", info.get("TYPE"))
    set_if_missing("fsver", info.get("VERSION"))

    # The partition-table UUID of a partition is its parent disk's.
    if kind == "part" and dev.get("ptuuid") in (None, ""):
        parent = dev.get("pkname")
        if parent:
            ppath = parent if parent.startswith("/dev/") else f"/dev/{parent}"
            set_if_missing("ptuuid", probe(ppath).get("PTUUID"))

    for child in dev.get("children") or []:
        fill(child)


for device in data.get("blockdevices") or []:
    fill(device)

json.dump(data, sys.stdout, indent=3)
sys.stdout.write("\n")
