# Lunar OS - i3
# Your config: edit freely. Keys: Super+Return terminal, Super+D apps,
# Super+Shift+Q close, Super+L lock, Super+1..9 workspaces.

set $mod Mod4
font pango:Noto Sans 10
floating_modifier $mod

exec --no-startup-id picom -b
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -n -c 000000
exec_always --no-startup-id feh --no-fehbg --bg-fill /usr/share/wallpapers/Lunar/contents/images/3840x2160.png

default_border pixel 2
gaps inner 6
gaps outer 8

# class                 border  bg      text    indicator child_border
client.focused          #969fff #000000 #e2e5f0 #969fff   #969fff
client.unfocused        #1a1a1f #000000 #6b6f7d #1a1a1f   #1a1a1f
client.focused_inactive #1a1a1f #000000 #9aa0b0 #1a1a1f   #1a1a1f

bar {
    position top
    status_command i3status
    tray_output primary
    # Translucent: colours carry an alpha channel (#RRGGBBAA).
    i3bar_command i3bar --transparency
    colors {
        background #00000099
        statusline #e2e5f0
        separator  #ffffff22
        focused_workspace  #00000000 #00000000 #969fff
        active_workspace   #00000000 #00000000 #e2e5f0
        inactive_workspace #00000000 #00000000 #6b6f7d
        urgent_workspace   #00000000 #00000000 #e06c75
    }
}

bindsym $mod+Return exec alacritty
bindsym $mod+d exec --no-startup-id dmenu_run -nb '#000000' -nf '#e2e5f0' -sb '#969fff' -sf '#000000'
bindsym $mod+e exec thunar
bindsym $mod+Shift+q kill
bindsym $mod+l exec --no-startup-id i3lock -c 000000
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec i3-nagbar -t warning -m 'Leave the session?' -B 'Log out' 'i3-msg exit'

bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+1 workspace number 1
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+9 move container to workspace number 9

bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl s 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl s 5%-
