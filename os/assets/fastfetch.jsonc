// Lunar OS fastfetch layout: the half moon, then the system details.
// Copy to ~/.config/fastfetch/config.jsonc to make your own version.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/etc/lunaros/fetch-logo.txt",
        "color": { "1": "38;2;226;229;240" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": ": ",
        "color": {
            "keys": "38;2;150;160;255",
            "title": "38;2;150;160;255"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        { "type": "command", "key": "Packages", "text": "ltxs count" },
        "shell",
        "display",
        "de",
        "wm",
        "theme",
        "icons",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "break",
        "colors"
    ]
}
