pkgname=lunar-hardening
pkgver=0.1.0
pkgrel=1
pkgdesc="Baseline hardening configuration for Lunar OS"
arch=('any')
url="https://lunaros.org"
license=('GPL3')
depends=('apparmor' 'nftables' 'audit')
optdepends=('hardened_malloc: preloaded allocator, AUR')
backup=('etc/sysctl.d/99-lunar-hardening.conf'
        'etc/modprobe.d/lunar-blacklist.conf'
        'etc/nftables.conf')
source=("lunar-os-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/lunar-os/hardening"

  # These files are already provided by the base Arch packages we depend on.
  # Installing copies of them here creates pacstrap conflicts during installs.
  local -a skip_files=(
    'etc/nftables.conf'
    'etc/security/faillock.conf'
    'etc/systemd/zram-generator.conf'
  )

  while IFS= read -r -d '' f; do
    local rel="${f#"$srcdir/lunar-os/hardening/"}"
    case " ${skip_files[*]} " in
      *" $rel "*) continue ;;
    esac
    install -Dm644 "$f" "$pkgdir/$rel"
  done < <(find etc -type f -print0)

  chmod 700 "$pkgdir/etc/nftables.conf" 2>/dev/null || true
}
