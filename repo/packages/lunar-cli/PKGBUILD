pkgname=lunar-cli
pkgver=0.1.0
pkgrel=1
pkgdesc="Lunar OS command set: lum, lunarfetch"
arch=('any')
url="https://lunaros.org"
license=('GPL3')
depends=('python' 'pacman')
optdepends=('pacman-contrib: pactree and paccache, used by lum tree and lum clean'
            'arch-audit: vulnerability reporting, used by lum audit'
            'btrfs-progs: snapshots before install and upgrade'
            'pciutils: GPU detection in lunarfetch')
source=("lunar-os-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/lunar-os/src"
  install -Dm755 lum/lum            "$pkgdir/usr/bin/lum"
  install -Dm755 fetch/lunarfetch   "$pkgdir/usr/bin/lunarfetch"
}
