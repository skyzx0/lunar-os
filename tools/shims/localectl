#!/usr/bin/env python3
"""localectl, for the two read-only queries archinstall makes, without dbus.

For test environments only. `localectl list-keymaps` and
`list-x11-keymap-layouts` are what archinstall calls to validate a chosen
keyboard layout before writing it - and both are static, file-based answers.
Real localectl still routes them through systemd's locale1 D-Bus service,
which only exists when systemd is actually running as PID 1. A bare
dbus-daemon provides the bus but not that service, so the call still fails -
this reads the same files systemd-localed would have and skips the bus
entirely.

Everything else is handed to the real binary unchanged, so a call this does
not know about fails loudly and specifically rather than being silently
misanswered.
"""

import glob
import os
import re
import shutil
import sys

REAL = shutil.which("localectl", path="/usr/bin:/usr/sbin:/bin:/sbin")


def real_or_die():
    if REAL is None:
        sys.exit("localectl shim: the real localectl was not found")
    os.execv(REAL, [REAL] + sys.argv[1:])


def list_keymaps() -> list:
    """Every basename under */kbd/keymaps ending .map.gz or .map, sorted and
    de-duplicated the way systemd's own enumeration behaves."""
    names = set()
    for root in ("/usr/share/kbd/keymaps", "/usr/share/keymaps"):
        for path in glob.glob(f"{root}/**/*.map.gz", recursive=True):
            names.add(re.sub(r"\.map\.gz$", "", os.path.basename(path)))
        for path in glob.glob(f"{root}/**/*.map", recursive=True):
            names.add(re.sub(r"\.map$", "", os.path.basename(path)))
    return sorted(names)


def list_x11_layouts() -> list:
    """The layout codes from the X11 XKB rules file's "! layout" section."""
    for path in ("/usr/share/X11/xkb/rules/base.lst",
                 "/usr/share/X11/xkb/rules/xorg.lst"):
        if not os.path.exists(path):
            continue
        layouts, in_section = [], False
        with open(path, errors="replace") as fh:
            for line in fh:
                if line.startswith("! layout"):
                    in_section = True
                    continue
                if line.startswith("!"):
                    in_section = False
                    continue
                if in_section and line.strip():
                    layouts.append(line.split()[0])
        if layouts:
            return sorted(set(layouts))
    return []


def main() -> int:
    args = sys.argv[1:]
    filtered = [a for a in args if a not in ("--no-pager",)]

    if filtered == ["list-keymaps"]:
        for name in list_keymaps():
            print(name)
        return 0

    if filtered == ["list-x11-keymap-layouts"]:
        layouts = list_x11_layouts()
        if not layouts:
            real_or_die()
        for name in layouts:
            print(name)
        return 0

    real_or_die()


if __name__ == "__main__":
    sys.exit(main())
