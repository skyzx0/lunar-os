// Lunar OS fastfetch layout: the half moon, then the system details.
// Copy to ~/.config/fastfetch/config.jsonc to make your own version.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/lunaros/fetch-logo.txt",
        "color": { "1": "38;2;226;229;240" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": ": ",
        "color": {
            "keys": "38;2;150;160;255",
            "title": "38;2;150;160;255"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        // The kernel's own version ends in Arch's build tag (6.16.8-arch1-1);
        // show just the version.
        {
            "type": "command",
            "key": "Kernel",
            "text": "echo \"Linux $(uname -r | sed -E 's/-arch[0-9]+-[0-9]+$//')\""
        },
        "uptime",
        { "type": "packages", "format": "{all} (ltxs)" },
        "shell",
        "display",
        "de",
        "wm",
        "theme",
        "icons",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "break",
        "colors"
    ]
}
