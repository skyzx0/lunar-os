#!/usr/bin/env python3
"""lunar-welcome - the first screen of a live session, in the terminal.

No graphical toolkit, no display server, nothing to start before it runs.
The moon is drawn from the circle equation so it fits whatever console it
lands on, rather than being stored as fixed ASCII art.
"""

import os
import shutil
import subprocess
import sys

RESET = "\033[0m"; DIM = "\033[2m"; BOLD = "\033[1m"
ACCENT = "\033[38;5;80m"; MUTED = "\033[38;5;245m"

SHADES = (231, 255, 254, 253, 252, 250, 248, 245)


def moon(rows: int = 12) -> list:
    """Half moon: right half of a disc, flat terminator on the left.

    Console cells are roughly twice as tall as wide, so x is sampled at double
    density to keep the disc circular.
    """
    cols = rows * 2
    out = []
    r = rows / 2.0
    for y in range(rows):
        line = []
        dy = (y + 0.5 - r) / r
        for x in range(cols):
            dx = (x + 0.5 - cols / 2.0) / (cols / 2.0)
            if dx >= 0.0 and dx * dx + dy * dy <= 1.0:
                depth = 1.0 - (dx * dx + dy * dy) ** 0.5
                idx = min(len(SHADES) - 1, int(depth * len(SHADES)))
                line.append(f"\033[38;5;{SHADES[idx]}m█")
            else:
                line.append(" ")
        out.append("".join(line).rstrip() + RESET)
    return out


def strip(text: str) -> str:
    out, i = [], 0
    while i < len(text):
        if text[i] == "\033":
            while i < len(text) and text[i] != "m":
                i += 1
            i += 1
            continue
        out.append(text[i])
        i += 1
    return "".join(out)


def has(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def escalate() -> list:
    if os.geteuid() == 0:
        return []
    for tool in ("sudo", "run0", "pkexec"):
        if has(tool):
            return [tool]
    return []


def run_root(*args) -> None:
    subprocess.call([*escalate(), *args])


def run(*args) -> None:
    subprocess.call(list(args))


def start_desktop() -> None:
    """Start Plasma on demand.

    The medium boots to a console deliberately: starting a desktop costs
    several hundred megabytes and a minute of boot for someone who came here
    to run an installer. It is one keystroke away for anyone who wants it.
    """
    if not has("startplasma-wayland"):
        print(f"\n  {MUTED}The desktop is not on this medium.{RESET}\n")
        return
    print(f"\n  {MUTED}Starting the desktop. Log out to return here.{RESET}\n")
    env = dict(os.environ, XDG_SESSION_TYPE="wayland",
               XDG_CURRENT_DESKTOP="KDE", XDG_SESSION_DESKTOP="KDE")
    if has("dbus-run-session"):
        subprocess.call(["dbus-run-session", "startplasma-wayland"], env=env)
    else:
        subprocess.call(["startplasma-wayland"], env=env)


MENU = [
    ("1", "Install Lunar OS",
     "Guided installer. Erases a disk, encrypts it, applies a security profile.",
     lambda: run_root("lunaros-setup")),
    ("2", "Install minimal",
     "Console-only system, smallest package set. Fastest option by far.",
     lambda: run_root("lunaros-setup", "--fast")),
    ("3", "Start the desktop",
     "Run the desktop for this session only. Nothing is written to disk.",
     start_desktop),
    ("4", "Manual installation",
     "Print every command the installer runs, to adapt yourself.",
     lambda: run("lunaros-setup", "--steps")),
    ("5", "Shell",
     "Leave this screen and use the system.",
     lambda: None),
]


def banner() -> None:
    art = moon(12)
    width = max(len(strip(l)) for l in art)
    rows = [
        f"{ACCENT}{BOLD}LUNAR OS{RESET}",
        f"{MUTED}live medium{RESET}",
        "",
        f"{MUTED}Encrypted by default.{RESET}",
        f"{MUTED}Hardened by default.{RESET}",
        "",
        f"{MUTED}Nothing has been written to any disk.{RESET}",
    ]
    print()
    for i in range(max(len(art), len(rows))):
        left = art[i] if i < len(art) else ""
        pad = " " * (width - len(strip(left)) + 4)
        right = rows[i] if i < len(rows) else ""
        print(f"  {left}{pad}{right}".rstrip())
    print()


def main() -> int:
    if "--no-clear" not in sys.argv:
        print("\033[2J\033[H", end="")
    banner()

    for key, title, blurb, _ in MENU:
        print(f"  {ACCENT}{key}{RESET}  {BOLD}{title}{RESET}")
        print(f"     {MUTED}{blurb}{RESET}")
    print()
    print(f"  {MUTED}Also: ltxs -h · lunarfetch · lunar-privacy status · "
          f"lunar-diagnose{RESET}")
    print()

    while True:
        try:
            choice = input(f"  {ACCENT}>{RESET} ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0

        if choice in ("5", "q", "quit", "exit", ""):
            print()
            return 0

        for key, _, _, action in MENU:
            if choice == key:
                action()
                print()
                print(f"  {MUTED}Run 'lunar-welcome' to return to this screen.{RESET}")
                print()
                return 0

        print(f"  {MUTED}Enter 1 to 5.{RESET}")


if __name__ == "__main__":
    sys.exit(main())
