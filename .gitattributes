# Everything in this tree is consumed by Linux tooling. Git on Windows must not
# rewrite line endings: a PKGBUILD or shebang with CRLF fails in ways that point
# nowhere near the real cause.
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
PKGBUILD    text eol=lf
*.install   text eol=lf
*.conf      text eol=lf
*.nft       text eol=lf
*.preset    text eol=lf
*.x86_64    text eol=lf
profiledef.sh text eol=lf
.zlogin     text eol=lf
Makefile    text eol=lf

# Windows-side helpers keep CRLF
*.ps1       text eol=crlf
*.cmd       text eol=crlf

*.iso       binary
*.fd        binary
*.qcow2     binary
*.gpg       binary
