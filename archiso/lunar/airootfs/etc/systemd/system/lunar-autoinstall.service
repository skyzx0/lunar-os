[Unit]
Description=Lunar unattended installation (testing only)
After=network-online.target lunar-live-user.service
Wants=network-online.target
ConditionKernelCommandLine=lunar.autoinstall

[Service]
Type=oneshot
ExecStart=/usr/local/bin/lunar-autoinstall
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
