pkgname=lunar-keyring
pkgver=0.1.0
pkgrel=1
pkgdesc="Lunar OS repository signing keys"
arch=('any')
url="https://lunaros.org"
license=('MIT')
install=lunar-keyring.install
source=('lunar.gpg' 'lunar-trusted' 'lunar-revoked')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 "$srcdir/lunar.gpg"      "$pkgdir/usr/share/pacman/keyrings/lunar.gpg"
  install -Dm644 "$srcdir/lunar-trusted"  "$pkgdir/usr/share/pacman/keyrings/lunar-trusted"
  install -Dm644 "$srcdir/lunar-revoked"  "$pkgdir/usr/share/pacman/keyrings/lunar-revoked"
}
