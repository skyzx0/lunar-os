pkgname=lunar-hardening
pkgver=0.1.0
pkgrel=2
pkgdesc="Baseline hardening configuration for Lunar OS"
arch=('any')
url="https://lunaros.org"
license=('GPL3')
depends=('apparmor' 'nftables' 'audit' 'pam')
optdepends=('hardened_malloc: preloaded allocator, AUR'
            'libpwquality: password quality rules in pwquality.conf.d')
backup=('etc/sysctl.d/99-lunar-hardening.conf'
        'etc/modprobe.d/lunar-blacklist.conf'
        'etc/lunar/nftables.conf')
install=lunar-hardening.install
source=("lunar-os-$pkgver.tar.gz")
sha256sums=('SKIP')

# No file here is owned by another Arch package. Where Arch owns the stock
# path, Lunar's settings go somewhere the owner reads without conflict:
#   firewall    /etc/lunar/nftables.conf + nftables.service drop-in
#   pwquality   /etc/security/pwquality.conf.d/lunar.conf
#   zram        /etc/systemd/zram-generator.conf.d/lunar.conf
#   faillock    /usr/share/lunar-hardening/, copied by the install script
package() {
  cd "$srcdir/lunar-os/hardening"
  find etc usr -type f | while read -r f; do
    install -Dm644 "$f" "$pkgdir/$f"
  done
  chmod 700 "$pkgdir/etc/lunar/nftables.conf"
}
