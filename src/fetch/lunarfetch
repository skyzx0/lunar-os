#!/usr/bin/env python3
"""lunarfetch - what this machine is, in one screen.

The moon is generated from the circle equation rather than stored as ASCII
art, so it stays a true half disc at any size and any terminal aspect ratio.

Stdlib only, no subprocess where /proc or /sys will answer. On a cold cache it
runs in a few milliseconds; a fetch tool that takes half a second is a tool
that makes your shell feel slow.
"""

import os
import platform
import shutil
import socket
import subprocess
import sys
import time

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"

# 256-colour ramp for the moon, bright limb to dark terminator.
MOON_SHADES = (231, 255, 254, 253, 252, 250, 248, 245)
ACCENT = 80          # cyan-ish
LABEL = 245


def sgr(code: int) -> str:
    return f"\033[38;5;{code}m"


# --------------------------------------------------------------------------
# the moon


def moon(rows: int = 16) -> list:
    """A half moon rendered with half-block characters.

    Terminal cells are about twice as tall as they are wide, so the x axis is
    sampled at double density to keep the disc circular rather than an egg.
    """
    cols = rows * 2
    out = []
    r = rows / 2.0

    for y in range(rows):
        line = []
        # Sample the centre of the cell, not its corner.
        dy = (y + 0.5 - r) / r
        for x in range(cols):
            dx = (x + 0.5 - cols / 2.0) / (cols / 2.0)
            inside = dx * dx + dy * dy <= 1.0
            lit = inside and dx >= 0.0        # right half only: a half moon

            if not lit:
                line.append(" ")
                continue

            # Shade by distance from the limb so the disc has some form
            # without becoming a gradient exercise.
            depth = 1.0 - (dx * dx + dy * dy) ** 0.5
            idx = min(len(MOON_SHADES) - 1, int(depth * len(MOON_SHADES)))
            line.append(sgr(MOON_SHADES[idx]) + "█")
        out.append("".join(line).rstrip() + RESET)
    return out


# --------------------------------------------------------------------------
# facts


def read(path: str, default: str = "") -> str:
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return default


def os_name() -> str:
    for line in read("/etc/os-release").splitlines():
        if line.startswith("PRETTY_NAME="):
            return line.split("=", 1)[1].strip().strip('"')
    return platform.system()


def uptime() -> str:
    secs = float(read("/proc/uptime", "0").split()[0])
    d, rem = divmod(int(secs), 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    parts = []
    if d:
        parts.append(f"{d}d")
    if h:
        parts.append(f"{h}h")
    parts.append(f"{m}m")
    return " ".join(parts)


def meminfo() -> dict:
    out = {}
    for line in read("/proc/meminfo").splitlines():
        key, _, rest = line.partition(":")
        try:
            out[key] = int(rest.split()[0]) * 1024
        except (IndexError, ValueError):
            pass
    return out


def memory() -> str:
    m = meminfo()
    total = m.get("MemTotal", 0)
    used = total - m.get("MemAvailable", 0)
    if not total:
        return "unknown"
    pct = used * 100 // total
    bar_len = 14
    filled = used * bar_len // total
    bar = "█" * filled + sgr(238) + "█" * (bar_len - filled) + RESET
    return f"{used // 1024**2} / {total // 1024**2} MiB  {bar} {pct}%"


def cpu() -> str:
    model = ""
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            model = line.split(":", 1)[1].strip()
            break
    if not model:
        model = platform.processor() or "unknown"
    # Trim the marketing.
    for junk in ("(R)", "(TM)", "CPU", "Processor", "  "):
        model = model.replace(junk, " ")
    cores = os.cpu_count() or 1
    return f"{' '.join(model.split())} ({cores} threads)"


def gpu() -> str:
    try:
        out = subprocess.run(["lspci", "-mm"], capture_output=True,
                             text=True, timeout=1).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    for line in out.splitlines():
        if '"VGA compatible controller"' in line or '"Display controller"' in line:
            fields = [f.strip('"') for f in line.split('" "')]
            if len(fields) > 3:
                return f"{fields[2]} {fields[3]}"
    return ""


def kernel() -> str:
    rel = platform.release()
    hardened = " hardened" if "hardened" in rel else ""
    return rel + (sgr(ACCENT) + hardened + RESET if hardened else "")


def packages() -> str:
    db = "/var/lib/pacman/local"
    if os.path.isdir(db):
        try:
            return str(len(os.listdir(db)) - 1)
        except OSError:
            pass
    return "unknown"


def shell() -> str:
    return os.path.basename(os.environ.get("SHELL", "")) or "unknown"


def desktop() -> str:
    d = os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("DESKTOP_SESSION", "")
    session = os.environ.get("XDG_SESSION_TYPE", "")
    if d and session:
        return f"{d} ({session})"
    return d or "none"


def disk() -> str:
    try:
        u = shutil.disk_usage("/")
    except OSError:
        return "unknown"
    pct = u.used * 100 // u.total
    return f"{u.used // 1024**3} / {u.total // 1024**3} GiB  {pct}%"


def security() -> list:
    """The part a fetch tool for this distribution should actually show.

    Anyone can print a kernel version. Whether the machine is doing what it
    claims - encrypted, enforcing, verified - is the useful question.
    """
    rows = []

    lsm = read("/sys/kernel/security/lsm")
    mac = "none"
    if "apparmor" in lsm:
        enforcing = read("/sys/module/apparmor/parameters/enabled") == "Y"
        mac = "AppArmor" + (" enforcing" if enforcing else " loaded")
    elif "selinux" in lsm:
        mac = "SELinux"
    rows.append(("Mandatory access", mac))

    lockdown = read("/sys/kernel/security/lockdown")
    if lockdown:
        # Format is [none] integrity confidentiality, brackets mark the active one.
        active = next((p.strip("[]") for p in lockdown.split() if p.startswith("[")), "?")
        rows.append(("Kernel lockdown", active))

    sb = "unknown"
    efi = "/sys/firmware/efi/efivars"
    if os.path.isdir(efi):
        for name in os.listdir(efi):
            if name.startswith("SecureBoot-"):
                try:
                    with open(os.path.join(efi, name), "rb") as fh:
                        sb = "enabled" if fh.read()[4:5] == b"\x01" else "disabled"
                except OSError:
                    pass
                break
    else:
        sb = "not UEFI"
    rows.append(("Secure Boot", sb))

    crypt = "no"
    if os.path.isdir("/sys/block"):
        for dev in os.listdir("/sys/block"):
            if dev.startswith("dm-") and read(f"/sys/block/{dev}/dm/uuid").startswith("CRYPT-LUKS"):
                crypt = "LUKS2"
                break
    rows.append(("Root encryption", crypt))

    return rows


# --------------------------------------------------------------------------
# layout


def render() -> str:
    art = moon(16)
    art_width = max(len(_strip(l)) for l in art)

    user = os.environ.get("USER") or os.environ.get("LOGNAME") or "user"
    host = socket.gethostname()

    rows = [
        ("", f"{sgr(ACCENT)}{BOLD}{user}{RESET}@{sgr(ACCENT)}{BOLD}{host}{RESET}"),
        ("", sgr(238) + "─" * 34 + RESET),
        ("System", os_name()),
        ("Kernel", kernel()),
        ("Uptime", uptime()),
        ("Packages", packages()),
        ("Shell", shell()),
        ("Desktop", desktop()),
        ("CPU", cpu()),
    ]
    g = gpu()
    if g:
        rows.append(("GPU", g))
    rows += [
        ("Memory", memory()),
        ("Disk", disk()),
        ("", ""),
    ]
    rows += [(k, v) for k, v in security()]

    lines = []
    pad = 3
    for i in range(max(len(art), len(rows))):
        left = art[i] if i < len(art) else ""
        left_pad = " " * (art_width - len(_strip(left)) + pad)

        if i < len(rows):
            label, value = rows[i]
            right = (f"{sgr(LABEL)}{label:<17}{RESET}{value}" if label else value)
        else:
            right = ""
        lines.append(f"{left}{left_pad}{right}".rstrip())

    return "\n".join(lines)


def _strip(text: str) -> str:
    """Length of a string ignoring SGR escapes."""
    out, i = [], 0
    while i < len(text):
        if text[i] == "\033":
            while i < len(text) and text[i] != "m":
                i += 1
            i += 1
            continue
        out.append(text[i])
        i += 1
    return "".join(out)


def main() -> int:
    if "--no-colour" in sys.argv or "--no-color" in sys.argv or not sys.stdout.isatty():
        text = render()
        # Strip SGR for pipes and logs.
        print(_strip(text))
        return 0
    print()
    print(render())
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
