[Unit]
Description=Create the Lunar OS live session user
DefaultDependencies=no
After=systemd-tmpfiles-setup.service
Before=sddm.service display-manager.service
ConditionPathExists=!/run/lunar-live-user-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/lunar-live-user
ExecStartPost=/usr/bin/touch /run/lunar-live-user-done

[Install]
WantedBy=multi-user.target
