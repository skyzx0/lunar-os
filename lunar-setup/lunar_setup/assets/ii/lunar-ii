#!/usr/bin/env bash
# lunar-ii - illogical-impulse for Hyprland on Lunar OS.
#
# illogical-impulse (github.com/end-4/dots-hyprland, GPL-3.0) is a complete,
# widely used Hyprland desktop: bar, overview, sidebars, launcher, settings,
# colours generated from the wallpaper. Lunar installs it at a pinned
# version that matches the Hyprland Lunar ships, and themes it as Lunar:
#
#   - the half-moon wallpaper and the Lunar accent: its own colour pipeline
#     builds the whole palette from them on first launch
#   - transparency on, the moon as the icon in the corner of its bar
#   - your keyboard layout (illogical-impulse assumes US), quick key repeat
#
#   lunar-ii --install-time USER   during the Lunar installation (as root)
#   lunar-ii                       install or reinstall later, as yourself
#   lunar-ii --first-login         offer it once if it is not installed yet
#
# If installing fails for any reason, Lunar's own Hyprland setup stays in
# place and the first login offers to try again.

set -uo pipefail

PIN="33f31a08caddd41422a2d97670adeeb52b4f1e7c"
REPO="https://github.com/end-4/dots-hyprland"
MOON="/usr/share/wallpapers/Lunar/contents/images/3840x2160.png"
KB_FILE="/etc/X11/xorg.conf.d/00-keyboard.conf"
LOOK_FILE="/etc/lunaros/look.json"

accent=$'\033[38;2;150;160;255m'; dim=$'\033[2m'; bold=$'\033[1m'; off=$'\033[0m'
say()  { printf '%s::%s %s\n' "$accent" "$off" "$*"; }
fail() { printf '\n%s!!%s %s\n' $'\033[31m' "$off" "$*" >&2; }

# --- Lunar's part, before illogical-impulse's installer --------------------
# Runs as the user; $HOME is theirs.
pre_tweaks() {
    local hypr="$HOME/.config/hypr"
    # Lunar's own Hyprland setup steps aside (kept, and restored on failure).
    if [[ -f "$hypr/hyprland.conf" && ! -e "$HOME/.config/hypr.lunar-classic" ]]; then
        mv "$hypr" "$HOME/.config/hypr.lunar-classic"
    fi

    # Keyboard: custom/ is loaded after illogical-impulse's defaults and never
    # overwritten by it, so this survives its updates.
    local layout=us variant=""
    if [[ -r "$KB_FILE" ]]; then
        layout=$(sed -n 's/.*"XkbLayout" *"\([^"]*\)".*/\1/p' "$KB_FILE" | head -1)
        variant=$(sed -n 's/.*"XkbVariant" *"\([^"]*\)".*/\1/p' "$KB_FILE" | head -1)
        layout=${layout:-us}
    fi
    mkdir -p "$hypr/custom"
    local custom="$hypr/custom/general.lua"
    if ! grep -q "Lunar OS" "$custom" 2>/dev/null; then
        {
            echo "-- Lunar OS: your keyboard layout and quick key repeat."
            echo "-- illogical-impulse loads this after its defaults and never overwrites it."
            echo "hl.config({"
            echo "    input = {"
            echo "        kb_layout = \"$layout\","
            if [[ -n "$variant" ]]; then echo "        kb_variant = \"$variant\","; fi
            echo "        repeat_delay = 250,"
            echo "        repeat_rate = 50,"
            echo "    },"
            echo "})"
            if [[ -s "$custom" ]]; then echo; cat "$custom"; fi
        } > "$custom.lunar"
        mv "$custom.lunar" "$custom"
    fi

    # Theme: illogical-impulse never ships or overwrites this file, and its
    # colour generation uses accentColor when it is set.
    local cfg="$HOME/.config/illogical-impulse/config.json"
    mkdir -p "$(dirname "$cfg")"
    python3 - "$cfg" "$LOOK_FILE" <<'PY'
import json, sys
p, look = sys.argv[1], sys.argv[2]
try:
    accent = json.load(open(look))["accent"]
except (OSError, ValueError, KeyError):
    accent = "#969fff"
try:
    c = json.load(open(p))
except (OSError, ValueError):
    c = {}
a = c.setdefault("appearance", {})
a.setdefault("palette", {}).update({"type": "scheme-tonal-spot", "accentColor": accent})
a.setdefault("transparency", {})["enable"] = True
c.setdefault("bar", {})["topLeftIcon"] = "lunar-symbolic"
json.dump(c, open(p, "w"), indent=4)
PY
}

# --- Lunar's part, after its installer --------------------------------------
# Its installer re-syncs the quickshell folder, so these go in afterwards.
post_tweaks() {
    local ii="$HOME/.config/quickshell/ii"
    [[ -d "$ii" ]] || return 1
    mkdir -p "$ii/assets/icons" "$ii/assets/images"
    printf '%s\n' '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="M8 1.5 A6.5 6.5 0 0 1 8 14.5 Z" fill="#ffffff"/></svg>' \
        > "$ii/assets/icons/lunar-symbolic.svg"
    # Its first launch sets this picture as the wallpaper and builds the
    # palette from it plus the accent: the moon, so the theme is Lunar's.
    if [[ -f "$MOON" ]]; then
        cp "$MOON" "$ii/assets/images/default_wallpaper.png"
    fi
    mkdir -p "$HOME/.config/lunaros"
    touch "$HOME/.config/lunaros/ii-installed"
    rm -f "$HOME/.config/lunaros/ii-declined"
}

restore_classic() {
    if [[ -d "$HOME/.config/hypr.lunar-classic" && ! -e "$HOME/.config/hypr/hyprland.lua" ]]; then
        rm -rf "$HOME/.config/hypr"
        mv "$HOME/.config/hypr.lunar-classic" "$HOME/.config/hypr"
    fi
}

fetch_source() {
    local src="$1"
    mkdir -p "$(dirname "$src")"
    if [[ -d "$src/.git" ]]; then
        git -C "$src" fetch --quiet origin || return 1
    else
        rm -rf "$src"
        git clone --quiet "$REPO" "$src" || return 1
    fi
    git -C "$src" -c advice.detachedHead=false checkout --quiet --force "$PIN"
}

# The steps of illogical-impulse's "setups" stage, done without a running
# session (its own version enables a user service with --now, which needs
# one). Runs as root.
system_setups() {
    local user="$1" home="$2"
    getent group i2c >/dev/null || groupadd i2c
    usermod -aG video,i2c,input "$user"
    echo i2c-dev > /etc/modules-load.d/i2c-dev.conf
    if [[ -e /usr/lib/systemd/user/ydotool.service ]]; then
        systemctl --global enable ydotool.service
    fi
    systemctl enable bluetooth.service 2>/dev/null || true
    # Its Python environment, as the user.
    runuser -u "$user" -- env HOME="$home" bash -c '
        set -e
        venv="$HOME/.local/state/quickshell/.venv"
        mkdir -p "$venv"
        uv venv --prompt .venv "$venv" -p 3.12 || true
        source "$venv/bin/activate"
        uv pip install -r "$HOME/.local/share/lunaros/dots-hyprland/sdata/uv/requirements.txt"
    '
}

# --- during the Lunar installation -----------------------------------------
if [[ "${1:-}" == "--install-time" ]]; then
    user="${2:?usage: lunar-ii --install-time USER}"
    home="/home/$user"
    (( EUID == 0 )) || { fail "--install-time runs as root, inside the installer"; exit 1; }
    log="${LUNAR_II_LOG:-/var/log/lunaros-ii-install.log}"
    sudoers="${LUNAR_II_SUDOERS:-/etc/sudoers.d/99-lunar-ii-install}"

    # Its installer needs sudo without a password prompt while it runs here.
    # Removed again however this ends.
    mkdir -p "$(dirname "$sudoers")"
    # "!authenticate" as well as NOPASSWD: archinstall gives the user a normal
    # password rule, and with that present "sudo -v" - the first thing the
    # illogical-impulse installer runs - still asks for a password, which
    # nobody can type during installation. This made every install fall back
    # to the first-login offer.
    printf 'Defaults:%s !authenticate\n%s ALL=(ALL) NOPASSWD: ALL\n' "$user" "$user" > "$sudoers"
    chmod 440 "$sudoers"
    trap 'rm -f "$sudoers"' EXIT

    as_user() { runuser -u "$user" -- env HOME="$home" USER="$user" LOGNAME="$user" "$@"; }
    vars="KB_FILE='$KB_FILE' LOOK_FILE='$LOOK_FILE' MOON='$MOON' REPO='$REPO' PIN='$PIN'"
    funcs="$(declare -f pre_tweaks post_tweaks restore_classic fetch_source)"
    ii_src='$HOME/.local/share/lunaros/dots-hyprland'

    {
        echo "== illogical-impulse install, $(date)"
        ok=1
        step() { echo "-- $1"; }
        step "Lunar theme and keyboard"
        as_user bash -c "$funcs; $vars; pre_tweaks" || { ok=0; echo "!! failed: Lunar theme and keyboard"; }
        (( ok )) && step "download (pinned ${PIN:0:7})"
        (( ok )) && { as_user bash -c "$funcs; $vars; fetch_source $ii_src" || { ok=0; echo "!! failed: download"; }; }
        # Every prompt its installer could show after a failure is answered
        # "e" (exit): with nobody at the keyboard, its default ("repeat")
        # would loop forever.
        (( ok )) && step "illogical-impulse installer"
        (( ok )) && { as_user bash -c "cd $ii_src && yes e | ./setup install --force --skip-allsetups" || { ok=0; echo "!! failed: illogical-impulse installer"; }; }
        (( ok )) && step "system setup (groups, services, Python environment)"
        (( ok )) && { system_setups "$user" "$home" || { ok=0; echo "!! failed: system setup"; }; }
        (( ok )) && step "moon wallpaper and icon"
        (( ok )) && { as_user bash -c "$funcs; $vars; post_tweaks" || { ok=0; echo "!! failed: moon wallpaper and icon"; }; }
        if (( ok )); then
            echo "== illogical-impulse installed"
        else
            echo "== illogical-impulse install failed; Lunar's Hyprland setup is kept, first login offers it again"
            as_user bash -c "$funcs; restore_classic"
        fi
    } >> "$log" 2>&1
    exit 0      # never fails the Lunar installation
fi

# --- later, as the user -----------------------------------------------------
if [[ "${1:-}" == "--first-login" ]]; then
    [[ -e "$HOME/.config/lunaros/ii-installed" || -e "$HOME/.config/lunaros/ii-declined" ]] && exit 0
    exec kitty --title "Lunar OS - illogical-impulse" "$0"
fi

if (( EUID == 0 )); then
    fail "run lunar-ii as your own user, not as root (it asks for your password when it needs it)"
    exit 1
fi

clear
printf '\n  %sLunar OS%s  %s- Hyprland, finished%s\n\n' "$bold" "$off" "$dim" "$off"
cat <<EOF
  This installs ${bold}illogical-impulse${off}, a complete Hyprland desktop, themed
  as Lunar: the moon, the Lunar accent, transparency, your keyboard.

  It takes ${bold}15-30 minutes${off}, needs the internet, and asks for your
  password for system packages.

EOF
read -r -p "  Install it now? [Y/n] " answer
if [[ "$answer" =~ ^[Nn] ]]; then
    mkdir -p "$HOME/.config/lunaros" && touch "$HOME/.config/lunaros/ii-declined"
    printf '\n  %sNot now. Run %slunar-ii%s any time.%s\n\n' "$dim" "$off$accent" "$off$dim" "$off"
    read -r -p "  Press Enter to close. " _; exit 0
fi
echo
say "Checking the connection"
curl -fsI --max-time 15 https://github.com >/dev/null \
    || { fail "no internet connection - connect first, then run lunar-ii"; read -r -p "  Press Enter to close. " _; exit 1; }
say "Getting illogical-impulse (pinned version ${PIN:0:7})"
fetch_source "$HOME/.local/share/lunaros/dots-hyprland" || { fail "could not download illogical-impulse"; exit 1; }
say "Lunar theme and keyboard"
pre_tweaks
say "Running the illogical-impulse installer (this is the long part)"
echo
if ! (cd "$HOME/.local/share/lunaros/dots-hyprland" && ./setup install --force); then
    restore_classic
    fail "the illogical-impulse installer stopped; its output is above. Your previous Hyprland setup is back."
    read -r -p "  Press Enter to close. " _; exit 1
fi
post_tweaks
echo
printf '  %sDone.%s Log out and back in to Hyprland. %sSuper+/ shows its shortcuts.%s\n\n' "$bold" "$off" "$dim" "$off"
read -r -p "  Press Enter to close. " _
