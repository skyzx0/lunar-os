"""Lunar Look - the settings app. Started by running `lunar-look` with no
arguments. Every change applies at once, to every desktop and app, through
the same engine as `lunar-look apply`."""

import os
import threading
from importlib.machinery import SourceFileLoader

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

_here = os.path.dirname(os.path.realpath(__file__))
_engine_path = os.path.join(_here, "lunar-look")
if not os.path.exists(_engine_path):
    _engine_path = "/usr/local/bin/lunar-look"
look = SourceFileLoader("lunar_look_engine", _engine_path).load_module()

PRESETS = [("Lunar", "#969fff"), ("Sky", "#7cc4ff"), ("Mint", "#7fe0c0"),
           ("Rose", "#ff8fb1"), ("Amber", "#ffc46b"), ("Silver", "#d6d9e4")]
SPEED_KEYS = ["fast", "normal", "slow"]

CSS = """
window.lunar { background-color: rgba(8, 8, 12, 0.90); }
.swatch { min-width: 28px; min-height: 28px; border-radius: 999px; padding: 0;
          border: 2px solid transparent; }
.swatch.selected { border-color: #e2e5f0; }
"""


class LookWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Lunar Look")
        self.set_default_size(560, 760)
        self.add_css_class("lunar")
        self.s = look.load()
        self._pending = None
        self._swatches = []

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        page = Adw.PreferencesPage()
        view.set_content(page)
        self.set_content(view)

        # --- colour ---------------------------------------------------------
        g = Adw.PreferencesGroup(title="Colour",
                                 description="The accent: borders, highlights, selection, bars.")
        row = Adw.ActionRow(title="Accent")
        box = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER)
        for name, hexv in PRESETS:
            b = Gtk.Button(tooltip_text=name)
            b.add_css_class("swatch")
            self._paint(b, hexv)
            b.connect("clicked", lambda _b, h=hexv: self.set_accent(h))
            box.append(b)
            self._swatches.append((b, hexv))
        self.color_button = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=False))
        self.color_button.set_rgba(self._rgba(self.s["accent"]))
        self.color_button.connect("notify::rgba", self.on_custom_colour)
        box.append(self.color_button)
        row.add_suffix(box)
        g.add(row)
        page.add(g)

        # --- transparency ---------------------------------------------------
        g = Adw.PreferencesGroup(title="Transparency")
        g.add(self.slider_row("Terminal", "How see-through terminals are",
                              "terminal_opacity", 0.30))
        g.add(self.slider_row("Windows", "Other windows (Plasma: through the theme, without flicker)",
                              "window_opacity", 0.50))
        blur = Adw.SwitchRow(title="Blur", subtitle="Soften what shows through")
        blur.set_active(self.s["blur"])
        blur.connect("notify::active", lambda r, _p: self.change("blur", r.get_active()))
        g.add(blur)
        page.add(g)

        # --- shape and motion -----------------------------------------------
        g = Adw.PreferencesGroup(title="Shape and motion")
        corners = Adw.SpinRow.new_with_range(0, 24, 1)
        corners.set_title("Corner rounding")
        corners.set_subtitle("Pixels")
        corners.set_value(self.s["rounding"])
        corners.connect("notify::value", lambda r, _p: self.change("rounding", int(r.get_value())))
        g.add(corners)
        speed = Adw.ComboRow(title="Animations", model=Gtk.StringList.new(["Fast", "Normal", "Slow"]))
        speed.set_selected(SPEED_KEYS.index(self.s["animation_speed"]))
        speed.connect("notify::selected",
                      lambda r, _p: self.change("animation_speed", SPEED_KEYS[r.get_selected()]))
        g.add(speed)
        page.add(g)

        # --- wallpaper ------------------------------------------------------
        g = Adw.PreferencesGroup(title="Wallpaper")
        self.wall_row = Adw.ActionRow(title="Picture")
        self._show_wallpaper()
        moon = Gtk.Button(label="The moon", valign=Gtk.Align.CENTER)
        moon.connect("clicked", lambda _b: self.change("wallpaper", look.DEFAULTS["wallpaper"],
                                                       then=self._show_wallpaper))
        choose = Gtk.Button(label="Choose…", valign=Gtk.Align.CENTER)
        choose.add_css_class("suggested-action")
        choose.connect("clicked", self.on_choose_wallpaper)
        self.wall_row.add_suffix(moon)
        self.wall_row.add_suffix(choose)
        g.add(self.wall_row)
        page.add(g)

        # --- reset ----------------------------------------------------------
        g = Adw.PreferencesGroup()
        reset = Gtk.Button(label="Reset to Lunar defaults", halign=Gtk.Align.CENTER)
        reset.add_css_class("pill")
        reset.connect("clicked", self.on_reset)
        g.add(reset)
        page.add(g)

        self._accent_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self._accent_css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self._mark_swatch()

    # --- helpers --------------------------------------------------------------

    @staticmethod
    def _rgba(hexv):
        c = Gdk.RGBA()
        c.parse(hexv)
        return c

    def _paint(self, button, hexv):
        p = Gtk.CssProvider()
        p.load_from_data(f"button {{ background: {hexv}; }}".encode())
        button.get_style_context().add_provider(p, Gtk.STYLE_PROVIDER_PRIORITY_USER)

    def _mark_swatch(self):
        for b, hexv in self._swatches:
            (b.add_css_class if hexv == self.s["accent"] else b.remove_css_class)("selected")
        a = self.s["accent"]
        on = look.palette(self.s)["on_accent"]
        self._accent_css.load_from_data((f"@define-color accent_bg_color {a};"
                                         f"@define-color accent_fg_color {on};"
                                         f"@define-color accent_color {a};").encode())

    def _show_wallpaper(self):
        w = self.s["wallpaper"]
        self.wall_row.set_subtitle("The moon" if w == look.DEFAULTS["wallpaper"] else os.path.basename(w))

    def slider_row(self, title, subtitle, key, low):
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low * 100, 100, 1)
        scale.set_value(self.s[key] * 100)
        scale.set_size_request(180, -1)
        scale.set_draw_value(True)
        scale.set_value_pos(Gtk.PositionType.LEFT)
        scale.set_format_value_func(lambda _s, v: f"{int(v)}%")
        scale.connect("value-changed", lambda sc: self.change(key, round(sc.get_value() / 100, 2)))
        row.add_suffix(scale)
        return row

    # --- changes --------------------------------------------------------------

    def change(self, key, value, then=None):
        self.s[key] = value
        self.s = look.validate(self.s)
        look.save(self.s)
        if then:
            then()
        # Sliders fire continuously; apply once they settle.
        if self._pending:
            GLib.source_remove(self._pending)
        self._pending = GLib.timeout_add(300, self._apply)

    def _apply(self):
        self._pending = None
        s = dict(self.s)
        threading.Thread(target=look.apply, args=(s,), daemon=True).start()
        return False

    def set_accent(self, hexv):
        self.color_button.set_rgba(self._rgba(hexv))   # fires on_custom_colour

    def on_custom_colour(self, button, _pspec):
        c = button.get_rgba()
        hexv = "#%02x%02x%02x" % (round(c.red * 255), round(c.green * 255), round(c.blue * 255))
        if hexv != self.s["accent"]:
            self.change("accent", hexv)
        self._mark_swatch()

    def on_choose_wallpaper(self, _b):
        f = Gtk.FileFilter()
        f.set_name("Pictures")
        f.add_mime_type("image/*")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(f)
        dialog = Gtk.FileDialog(title="Choose a wallpaper", filters=filters)

        def done(d, result):
            try:
                file = d.open_finish(result)
            except GLib.Error:
                return
            if file and file.get_path():
                self.change("wallpaper", file.get_path(), then=self._show_wallpaper)
        dialog.open(self, None, done)

    def on_reset(self, _b):
        try:
            os.remove(look.USER_FILE)
        except OSError:
            pass
        self.s = look.load()
        look.apply(self.s)
        self.close()
        self.get_application().activate()   # reopen with the defaults shown


def run():
    app = Adw.Application(application_id="org.lunaros.Look")

    def activate(a):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        css = Gtk.CssProvider()
        css.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        LookWindow(a).present()
    app.connect("activate", activate)
    app.run([])
