#!/usr/bin/env bash
# Creates the passwordless live-session account.
#
# Live media are a shared, throwaway context; a password protects nothing here
# and only obstructs someone trying to install. Root stays reachable from the
# local console on purpose: if the display manager fails, that console is the
# only way to diagnose it.
set -euo pipefail

id lunar &>/dev/null || useradd -m -G wheel,audio,video,storage,network \
    -s /bin/zsh -c "Lunar OS live session" lunar

# Empty passwords, not locked accounts. pam_unix needs 'nullok' to accept
# these at a TTY, which is set in the live PAM configuration.
passwd -d lunar
passwd -d root

install -Dm0440 /dev/stdin /etc/sudoers.d/10-lunar-live <<'SUDO'
%wheel ALL=(ALL:ALL) NOPASSWD: ALL
SUDO

# The installer is curses and needs a terminal, so the desktop launcher opens
# one rather than trying to run it directly.
install -d -o lunar -g lunar /home/lunar/Desktop
install -Dm755 -o lunar -g lunar /usr/share/applications/lunar-setup.desktop \
    /home/lunar/Desktop/lunar-setup.desktop
