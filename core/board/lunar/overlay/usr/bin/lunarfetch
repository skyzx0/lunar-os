#!/bin/bash
# lunarfetch: the half moon and what this machine is.
. /usr/lib/os-release
a=$'\e[38;2;150;160;255m'; d=$'\e[2m'; o=$'\e[0m'
mem=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%.1f / %.1f GiB",(t-a)/1048576,t/1048576}' /proc/meminfo)
cpu=$(sed -n 's/^model name\s*: //p' /proc/cpuinfo | head -1 | tr -s ' ')
up=$(awk '{h=int($1/3600);m=int($1%3600/60);printf "%dh %dm",h,m}' /proc/uptime)
gpu=$(cat /sys/class/drm/card*/device/uevent 2>/dev/null | sed -n 's/^DRIVER=//p' | head -1)
info=(
  "${a}${USER}${o}@${a}$(hostname)${o}"
  "${d}--------------------${o}"
  "${a}os${o}      $PRETTY_NAME"
  "${a}kernel${o}  $(uname -r)"
  "${a}uptime${o}  $up"
  "${a}shell${o}   ${SHELL##*/}"
  "${a}desktop${o} ${XDG_CURRENT_DESKTOP:-console}"
  "${a}cpu${o}     ${cpu:-unknown}"
  "${a}gpu${o}     ${gpu:-unknown}"
  "${a}memory${o}  $mem"
  ""
  "${d}See what's on the other side of the moon.${o}"
)
mapfile -t logo < /usr/share/lunar/logo.txt
n=$(( ${#logo[@]} > ${#info[@]} ? ${#logo[@]} : ${#info[@]} ))
echo
for ((i = 0; i < n; i++)); do
  l=${logo[i]:-}; l=${l#|}
  printf '  %s%-20s%s  %s\n' "$a" "$l" "$o" "${info[i]:-}"
done
echo
