# Lunar OS boot splash.
#
# Black, the half moon in the centre, a spinning ring of dots low on the
# screen and "Lunar OS" beneath it - the layout laptop makers use for their
# own boot screens. On an encrypted system the ring gives way to the
# passphrase prompt; boot errors appear at the very bottom, never hidden.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

scale = screen_height / 1080;
if (scale < 0.5) scale = 0.5;
if (scale > 2.0) scale = 2.0;

# --- the moon, exactly centred ---------------------------------------------

moon.image  = Image("moon.png");
moon.scaled = moon.image.Scale(moon.image.GetWidth() * scale, moon.image.GetHeight() * scale);
moon.sprite = Sprite(moon.scaled);
moon.sprite.SetX(screen_width  / 2 - moon.scaled.GetWidth()  / 2);
moon.sprite.SetY(screen_height / 2 - moon.scaled.GetHeight() / 2);
moon.sprite.SetZ(10);

# --- spinning ring ---------------------------------------------------------

ring_count = 8;
ring_r     = 16 * scale;
ring_x     = screen_width / 2;
ring_y     = screen_height * 0.80;
dot_size   = 7 * scale;

for (i = 0; i < ring_count; i++) {
    angle = i / ring_count * 2 * Math.Pi - Math.Pi / 2;
    ring[i].image  = Image("dot-0.png").Scale(dot_size, dot_size);
    ring[i].sprite = Sprite(ring[i].image);
    ring[i].sprite.SetX(ring_x + Math.Cos(angle) * ring_r - dot_size / 2);
    ring[i].sprite.SetY(ring_y + Math.Sin(angle) * ring_r - dot_size / 2);
    ring[i].sprite.SetZ(10);
    ring[i].sprite.SetOpacity(0.15);
}
ring_visible = 1;

# --- name at the bottom ----------------------------------------------------

brand.image  = Image.Text("Lunar OS", 0.82, 0.84, 0.90, 1, "Sans 12");
brand.sprite = Sprite(brand.image);
brand.sprite.SetX(screen_width / 2 - brand.image.GetWidth() / 2);
brand.sprite.SetY(screen_height * 0.88);
brand.sprite.SetZ(10);

# --- animation -------------------------------------------------------------

tick = 0;

fun refresh_callback() {
    tick++;
    if (ring_visible == 0) return;
    head = Math.Int(tick / 4) % ring_count;
    for (i = 0; i < ring_count; i++) {
        behind = (head - i + ring_count) % ring_count;
        ring[i].sprite.SetOpacity(1.0 - behind / ring_count * 0.85);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- passphrase prompt -----------------------------------------------------
# With an encrypted disk this is the screen most boots stop on: it replaces
# the ring, in the same place, and must be obviously waiting for input.

prompt_sprite  = Sprite();
bullets_sprite = Sprite();

fun display_password_callback(prompt, bullets) {
    ring_visible = 0;
    for (i = 0; i < ring_count; i++) ring[i].sprite.SetOpacity(0);

    prompt_image = Image.Text("Enter passphrase to unlock", 0.85, 0.87, 0.92, 1, "Sans 12");
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetX(screen_width / 2 - prompt_image.GetWidth() / 2);
    prompt_sprite.SetY(ring_y - 30 * scale);
    prompt_sprite.SetZ(20);

    dot_string = "";
    for (i = 0; i < bullets; i++) dot_string += "*";
    bullets_image = Image.Text(dot_string, 0.85, 0.87, 0.92, 1, "Sans 14");
    bullets_sprite.SetImage(bullets_image);
    bullets_sprite.SetX(screen_width / 2 - bullets_image.GetWidth() / 2);
    bullets_sprite.SetY(ring_y + 4 * scale);
    bullets_sprite.SetZ(20);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt_sprite.SetImage(Image.Text("", 0, 0, 0));
    bullets_sprite.SetImage(Image.Text("", 0, 0, 0));
    ring_visible = 1;
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- messages --------------------------------------------------------------
# Errors must be visible. A splash that hides a failed fsck is worse than no
# splash at all.

message_sprite = Sprite();
message_sprite.SetPosition(screen_width * 0.5, screen_height * 0.95, 30);

fun message_callback(text) {
    image = Image.Text(text, 0.6, 0.62, 0.68, 1, "Sans 9");
    message_sprite.SetImage(image);
    message_sprite.SetX(screen_width / 2 - image.GetWidth() / 2);
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback() {
    moon.sprite.SetOpacity(0);
    brand.sprite.SetOpacity(0);
    for (i = 0; i < ring_count; i++) ring[i].sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
